+	VMULSD 0(R15), X12, X6
+	VADDSD X13, X6, X6
+	VADDSD 24(R15), X6, X6
+	VMULSD 8(R15), X14, X7
+	VADDSD X7, X6, X6
+	VMULSD 16(R15), X15, X10
+	VMULSD X5, X10, X10
+	VADDSD X10, X6, X6
+	VUCOMISD X11, X6
+	JA next128
+	MOVL 0(R13), BX
+	MOVQ offs+24(FP), DX
+	MOVQ 0(DX)(BX*8), DX
+	MOVQ DX, 0(AX)
+	MOVQ pks+16(FP), DX
+	MOVQ 0(DX)(BX*8), DX
+	MOVQ DX, 8(AX)
+	ADDQ $16, AX
+next128:
