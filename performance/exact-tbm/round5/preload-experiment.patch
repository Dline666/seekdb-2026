+	VMOVDQU 0(DI), Y5
+	// VPDPBUSD Y0, Y5, Y8 (VEX.256).
+	BYTE $0xC4; BYTE $0x62; BYTE $0x55; BYTE $0x50; BYTE $0xC0
+	VMOVDQU 32(DI), Y6
+	// VPDPBUSD Y2, Y6, Y9.
+	BYTE $0xC4; BYTE $0x62; BYTE $0x4D; BYTE $0x50; BYTE $0xCA
+	VMOVDQU 64(DI), Y5
+	// VPDPBUSD Y3, Y5, Y8.
+	BYTE $0xC4; BYTE $0x62; BYTE $0x55; BYTE $0x50; BYTE $0xC3
+	VMOVDQU 96(DI), Y6
+	// VPDPBUSD Y4, Y6, Y9.
+	BYTE $0xC4; BYTE $0x62; BYTE $0x4D; BYTE $0x50; BYTE $0xCC
+	VPADDD Y9, Y8, Y8
+	VEXTRACTF128 $1, Y8, X1
+	VPADDD X1, X8, X8
+	VPSHUFD $0x4E, X8, X1
+	VPADDD X1, X8, X8
+	VPSHUFD $0xB1, X8, X1
+	VPADDD X1, X8, X8
+	VMOVD X8, CX
