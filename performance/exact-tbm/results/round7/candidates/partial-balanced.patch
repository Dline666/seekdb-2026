diff --git a/minivectordb/internal/engine/partial_balanced_test.go b/minivectordb/internal/engine/partial_balanced_test.go
new file mode 100644
--- /dev/null
+++ b/minivectordb/internal/engine/partial_balanced_test.go
@@ -0,0 +1,107 @@
+package engine
+
+import (
+	"math"
+	"testing"
+)
+
+func TestPartialBalancedIndependentTruth(t *testing.T) {
+	if !partialQuantTestModes(t) {
+		t.Skip("balanced partial scans require SIMD")
+	}
+	const n, dim, budget = 1539, 33, 180 << 10
+	db := openPartialDB(t, t.TempDir(), budget)
+	defer db.Close()
+	truth := partialFixture(t, db, "docs", n, dim, false)
+	x := checkPartialPrefix(t, db, "docs")
+	qn := x.quantRows
+	if scanWorkers(n) != 2 || qn < 2 || n-qn < 2 || (qn+(n-qn)/2)%scanBatch == 0 {
+		t.Fatal("fixture must give both workers mixed ranges and an unaligned tail split")
+	}
+	zero := make([]float32, dim)
+	q := make([]float32, dim)
+	q[0], q[dim-1] = 0.125, -0.25
+	// Put exact ties at both sides of every new range boundary. Missing a
+	// range, revisiting a row, or losing PK tie order changes the oracle result.
+	for _, slot := range []int{qn/2 - 1, qn / 2, qn - 1, qn, qn + (n-qn)/2 - 1, qn + (n-qn)/2, n - 1} {
+		partialUpdate(t, db, truth, x.pks[slot], "c1", q)
+	}
+	check := func(query []float32, k int, cat string, minID int64) {
+		t.Helper()
+		before := partialBalancedWorkers.Load()
+		checkPartialTruth(t, db, "docs", truth, query, k, cat, minID)
+		if delta := partialBalancedWorkers.Load() - before; delta != 2 {
+			t.Fatalf("query must use two workers with coded and uncoded ranges: got %d", delta)
+		}
+	}
+	check(q, 17, "", -1)
+	check(q, 17, "c1", -1)
+	check(q, 17, "c1", 100)
+	check(zero, 31, "", -1)
+	prefilter6Bit = true
+	check(q, 17, "c1", 100)
+	prefilter6Bit = false
+
+	// The normal equality set is ordered. Deliberately reorder its backing
+	// slice to prove the production guard chooses the original partitioning.
+	slots, ok := x.eqSlots(db, db.tables["docs"], 1, "c1")
+	if !ok || len(slots) < 2 {
+		t.Fatal("missing equality candidates")
+	}
+	func() {
+		slots[0], slots[len(slots)-1] = slots[len(slots)-1], slots[0]
+		defer func() { slots[0], slots[len(slots)-1] = slots[len(slots)-1], slots[0] }()
+		before := partialBalancedWorkers.Load()
+		checkPartialTruth(t, db, "docs", truth, q, 17, "c1", -1)
+		if partialBalancedWorkers.Load() != before {
+			t.Fatal("unordered candidate slots used the balanced partition")
+		}
+	}()
+
+	// Shadow a row from each region and add a lower-PK overlay tie. The
+	// overlay is merged once, after the two workers' disjoint base ranges.
+	committed := clonePartialTruth(truth)
+	mustExec(t, db, "BEGIN")
+	partialUpdate(t, db, truth, x.pks[qn/2], "c1", zero)
+	partialUpdate(t, db, truth, x.pks[qn+(n-qn)/2], "c1", zero)
+	partialInsert(t, db, "docs", truth, -100, "c1", zero)
+	check(zero, 17, "", -1)
+	check(zero, 17, "c1", -1)
+	check(zero, 17, "c1", 100)
+	mustExec(t, db, "ROLLBACK")
+	truth = committed
+	check(q, 17, "", -1)
+	checkPartialBudget(t, db)
+
+	// Serial scans and unavailable quantization retain the existing route.
+	parallelMinSlots = math.MaxInt
+	before := partialBalancedWorkers.Load()
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	parallelMinSlots, prefilterEnabled = 1, false
+	checkPartialTruth(t, db, "docs", truth, q, 17, "c1", -1)
+	if partialBalancedWorkers.Load() != before {
+		t.Fatal("fallback query used a balanced partial partition")
+	}
+}
+
+func TestPartialBalancedCandidateOrder(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		slots  []int32
+		q, cut int
+		ok     bool
+	}{
+		{"empty", nil, 128, 0, true},
+		{"covered", []int32{0, 63, 127}, 128, 3, true},
+		{"uncoded", []int32{128, 129, 300}, 128, 0, true},
+		{"boundary", []int32{0, 127, 128, 300}, 128, 2, true},
+		{"unaligned", []int32{1, 128, 129, 300}, 129, 2, true},
+		{"unordered", []int32{300, 0, 127, 128}, 128, 0, false},
+		{"duplicate", []int32{0, 0, 128}, 128, 0, false},
+	} {
+		cut, ok := partialCandidateCut(tc.slots, tc.q)
+		if cut != tc.cut || ok != tc.ok {
+			t.Fatalf("%s: cut=%d ok=%t want cut=%d ok=%t", tc.name, cut, ok, tc.cut, tc.ok)
+		}
+	}
+}
diff --git a/minivectordb/internal/engine/partial_delete_budget_test.go b/minivectordb/internal/engine/partial_delete_budget_test.go
new file mode 100644
--- /dev/null
+++ b/minivectordb/internal/engine/partial_delete_budget_test.go
@@ -0,0 +1,70 @@
+package engine
+
+import "testing"
+
+// Deleting rows cannot release the backing map or slot arrays. The newly
+// allocated free-slot list therefore needs its own budget check, even when
+// the live row count falls and the row payload is no longer indexed.
+func TestPartialQuantDeleteEnforcesBudget(t *testing.T) {
+	partialQuantTestModes(t)
+	const n, dim = 40, 32
+	fullBudget := int64(n)*(indexBytesPerRow+dim+32) + int64(dim)*4 + quantBlockBytes(n)
+	for _, tc := range []struct {
+		name   string
+		budget int64
+		full   bool
+	}{
+		{"full-quantization", fullBudget, true},
+		{"slots-only", int64(n) * indexBytesPerRow, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			db := openPartialDB(t, dir, tc.budget)
+			defer func() { db.Close() }()
+			truth := partialFixture(t, db, "docs", n, dim, false)
+			x := db.tables["docs"].Index
+			if x.Disabled || x.derivedBytes() != tc.budget {
+				t.Fatalf("fixture must exactly fill its budget: disabled=%t derived=%d budget=%d", x.Disabled, x.derivedBytes(), tc.budget)
+			}
+			if tc.full && x.quantRows != n || !tc.full && x.quantRows != 0 {
+				t.Fatalf("wrong initial coverage: full=%t Q=%d", tc.full, x.quantRows)
+			}
+			if len(x.free) != 0 || cap(x.free) != 0 {
+				t.Fatal("fixture must allocate its first free slot on DELETE")
+			}
+
+			// The final inserted row ties at distance zero and has the lowest
+			// PK, so removing it must change the independent expected TopK.
+			q := make([]float32, dim)
+			checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+			mustExec(t, db, "DELETE FROM docs WHERE id=1")
+			delete(truth, 1)
+
+			// Check before any query can alter derived state. On the broken
+			// implementation free grows while the other retained charges stay
+			// fixed, exceeding the originally exact-fit budget.
+			checkPartialBudget(t, db)
+			if tc.full {
+				if x.Disabled || x.quantRows != 0 || x.codes != nil || x.qf != nil || x.qbounds != nil {
+					t.Fatal("DELETE should release optional quantization and retain the exact slot index")
+				}
+			} else if !x.Disabled || x.derivedBytes() != 0 || x.posRows != 0 {
+				t.Fatal("DELETE must disable an over-budget slot index and release its retained charges")
+			}
+			checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+			checkPartialTruth(t, db, "docs", truth, q, 17, "c1", -1)
+			checkPartialTruth(t, db, "docs", truth, q, 17, "c1", 20)
+			checkPartialBudget(t, db)
+
+			// The fallback is derived state; the committed deletion must
+			// survive rebuilding the explicit index with the same allowance.
+			if err := db.Close(); err != nil {
+				t.Fatal(err)
+			}
+			db = openPartialDB(t, dir, tc.budget)
+			checkPartialBudget(t, db)
+			checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+			checkPartialTruth(t, db, "docs", truth, q, 17, "c1", -1)
+		})
+	}
+}
diff --git a/minivectordb/internal/engine/partial_growth_boundary_test.go b/minivectordb/internal/engine/partial_growth_boundary_test.go
new file mode 100644
--- /dev/null
+++ b/minivectordb/internal/engine/partial_growth_boundary_test.go
@@ -0,0 +1,102 @@
+package engine
+
+import (
+	"math"
+	"testing"
+)
+
+// A frozen full index can end inside a 128-row block. Rebuild-only partial
+// fixtures cannot exercise this state because their prefixes are aligned.
+func TestPartialQuantFreezeAtUnalignedBoundary(t *testing.T) {
+	hostSIMD := partialQuantTestModes(t)
+	parallelMinSlots = math.MaxInt
+	const n, dim = 129, 3072
+	fullBytes := int64(n)*(indexBytesPerRow+dim+32) + int64(dim)*4 + quantBlockBytes(n)
+	// One more fully encoded row costs 3168 bytes. The slot/map capacity
+	// growth costs less than 3000 bytes, so the existing prefix can survive
+	// freezing without allocating another row of codes.
+	budget := fullBytes + 3000
+	dir := t.TempDir()
+	db := openPartialDB(t, dir, budget)
+	defer func() { db.Close() }()
+	truth := partialFixture(t, db, "docs", n, dim, false)
+	x := db.tables["docs"].Index
+	if x.Disabled || x.quantRows != n || x.quantLimit != -1 || x.derivedBytes() != fullBytes {
+		t.Fatalf("expected initial full index: disabled=%t Q=%d limit=%d bytes=%d want=%d", x.Disabled, x.quantRows, x.quantLimit, x.derivedBytes(), fullBytes)
+	}
+	q := make([]float32, dim)
+	far := make([]float32, dim)
+	for j := range far {
+		far[j] = 2
+	}
+	// The final coded row will later become nearest. Its previous constants
+	// would reject it against a zero-distance heap unless UPDATE reencodes.
+	partialUpdate(t, db, truth, 1, "boundary", far)
+	partialInsert(t, db, "docs", truth, 0, "tail", q)
+	checkBoundary := func() {
+		t.Helper()
+		if x.Disabled || x.quantRows != n || x.quantLimit != n || len(x.pks) != n+1 || x.quantRows%quantBlockRows == 0 {
+			t.Fatalf("expected retained nonaligned frozen prefix: disabled=%t Q=%d limit=%d slots=%d", x.Disabled, x.quantRows, x.quantLimit, len(x.pks))
+		}
+		if len(x.codes) != n*dim || len(x.qf) != n*4 || len(x.qbounds) != 2 {
+			t.Fatal("frozen growth appended or removed encoded storage")
+		}
+		checkPartialBudget(t, db)
+	}
+	checkBoundary()
+	batches, coded, uncoded := partialPrefilterBatches.Load(), partialPrefilterRows.Load(), partialUncodedRows.Load()
+	// The first full batch establishes a zero-distance heap; batch two has
+	// slot 128 (coded) and slot 129 (uncoded), whose PK=0 must win the tie.
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	if hostSIMD && (partialPrefilterBatches.Load() <= batches || partialPrefilterRows.Load() <= coded || partialUncodedRows.Load() <= uncoded) {
+		t.Fatal("nonaligned freeze fixture did not exercise a mixed coded/tail batch")
+	}
+	checkPartialTruth(t, db, "docs", truth, q, 17, "tail", -1)
+
+	partialUpdate(t, db, truth, 1, "boundary", q)
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	tailQuery := make([]float32, dim)
+	tailQuery[dim-1] = 0.5
+	partialUpdate(t, db, truth, 0, "tail", tailQuery)
+	checkPartialTruth(t, db, "docs", truth, tailQuery, 1, "", -1)
+	checkPartialTruth(t, db, "docs", truth, tailQuery, 17, "tail", -1)
+	checkBoundary()
+
+	// Leave a rejecting code in the covered slot, then delete both boundary
+	// rows and reuse their slots in reverse order. The new lower PK ties
+	// arrive last and must still rank first.
+	partialUpdate(t, db, truth, 1, "boundary", far)
+	mustExec(t, db, "DELETE FROM docs WHERE id=1")
+	delete(truth, 1)
+	mustExec(t, db, "DELETE FROM docs WHERE id=0")
+	delete(truth, 0)
+	checkBoundary()
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	partialInsert(t, db, "docs", truth, -1, "reused", q)
+	partialInsert(t, db, "docs", truth, -2, "reused", q)
+	if x.pos[-1] != n || x.pos[-2] != n-1 {
+		t.Fatal("fixture did not reuse the uncoded and coded boundary slots")
+	}
+	checkBoundary()
+	for _, six := range []bool{false, true} {
+		prefilter6Bit = six
+		checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+		checkPartialTruth(t, db, "docs", truth, q, 17, "reused", -1)
+	}
+	prefilter6Bit = false
+	parallelMinSlots = 1
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	useSIMD = false
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	useSIMD = hostSIMD
+	checkPartialBudget(t, db)
+
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db = openPartialDB(t, dir, budget)
+	// Recovery may choose a different safe coverage under its headroom rule.
+	checkPartialBudget(t, db)
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	checkPartialTruth(t, db, "docs", truth, q, 17, "reused", -1)
+}
diff --git a/minivectordb/internal/engine/partial_quant_test.go b/minivectordb/internal/engine/partial_quant_test.go
new file mode 100644
--- /dev/null
+++ b/minivectordb/internal/engine/partial_quant_test.go
@@ -0,0 +1,445 @@
+package engine
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+
+	"minivectordb/internal/storage"
+)
+
+type partialTruthRow struct {
+	cat string
+	vec []float32
+}
+
+// The oracle ranks a separate copy of the input by scalar float64 squared
+// distance and primary key. It never calls a distance or quantization helper.
+func checkPartialTruth(t *testing.T, db *DB, table string, truth map[int64]partialTruthRow, q []float32, k int, cat string, minID int64) {
+	t.Helper()
+	type answer struct {
+		id int64
+		sq float64
+	}
+	want := make([]answer, 0, len(truth))
+	for id, row := range truth {
+		if cat != "" && row.cat != cat || minID >= 0 && id <= minID {
+			continue
+		}
+		var sq float64
+		for j, f := range q {
+			d := float64(f) - float64(row.vec[j])
+			sq += d * d
+		}
+		want = append(want, answer{id, sq})
+	}
+	sort.Slice(want, func(i, j int) bool {
+		return want[i].sq < want[j].sq || want[i].sq == want[j].sq && want[i].id < want[j].id
+	})
+	where := ""
+	if cat != "" {
+		where = " WHERE cat='" + cat + "'"
+	}
+	if minID >= 0 {
+		if where == "" {
+			where = " WHERE "
+		} else {
+			where += " AND "
+		}
+		where += fmt.Sprintf("id>%d", minID)
+	}
+	sql := fmt.Sprintf("SELECT id,L2_DISTANCE(e,'%s') AS d FROM %s%s ORDER BY d LIMIT %d", vectorText(q), table, where, k)
+	got := mustExec(t, db, sql).Rows
+	if len(got) != min(k, len(want)) {
+		t.Fatalf("%s: got %d rows, want %d", sql, len(got), min(k, len(want)))
+	}
+	for i, row := range got {
+		d := math.Sqrt(want[i].sq)
+		if row[0].I != want[i].id || math.IsNaN(row[1].F) || math.Abs(row[1].F-d) > 1e-12*math.Max(1, d) {
+			t.Fatalf("%s: rank %d got id=%d d=%g, want id=%d d=%g", sql, i, row[0].I, row[1].F, want[i].id, d)
+		}
+	}
+}
+
+func partialQuantTestModes(t *testing.T) bool {
+	t.Helper()
+	pre, six, cat, fused := prefilterEnabled, prefilter6Bit, catBlocksEnabled, fusedCandidatesEnabled
+	simd, batch, parallel, workers := useSIMD, batchScan, parallelMinSlots, maxScanWorkers
+	procs := runtime.GOMAXPROCS(2)
+	t.Cleanup(func() {
+		prefilterEnabled, prefilter6Bit, catBlocksEnabled, fusedCandidatesEnabled = pre, six, cat, fused
+		useSIMD, batchScan, parallelMinSlots, maxScanWorkers = simd, batch, parallel, workers
+		runtime.GOMAXPROCS(procs)
+	})
+	prefilterEnabled, prefilter6Bit, catBlocksEnabled, fusedCandidatesEnabled = true, false, true, true
+	batchScan, parallelMinSlots, maxScanWorkers = true, 1, 2
+	return simd
+}
+
+func openPartialDB(t *testing.T, dir string, budget int64) *DB {
+	t.Helper()
+	db, err := Open(dir, Options{Sync: storage.SyncData, IndexMemBytes: budget})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return db
+}
+
+func partialFixture(t *testing.T, db *DB, table string, n, dim int, unique bool) map[int64]partialTruthRow {
+	t.Helper()
+	mustExec(t, db, fmt.Sprintf("CREATE TABLE %s(id BIGINT PRIMARY KEY,cat VARCHAR(64),e VECTOR(%d))", table, dim))
+	truth := make(map[int64]partialTruthRow, n)
+	for start := 0; start < n; start += 64 {
+		var sql strings.Builder
+		fmt.Fprintf(&sql, "INSERT INTO %s VALUES ", table)
+		for i := start; i < min(start+64, n); i++ {
+			v := make([]float32, dim)
+			for j := range v {
+				// Binary-exact coordinates make the scalar oracle independent
+				// of accumulation order for ordinary rows.
+				v[j] = float32((i*19+j*7)%97-48) / 16
+			}
+			if i < 24 || i == n-1 {
+				clear(v)
+			}
+			if i == 129 || i == n-2 {
+				v[0] = 1e20
+			}
+			id := int64(n - i) // exact ties arrive in reverse PK order
+			cat := fmt.Sprintf("c%d", id%3)
+			if unique {
+				cat = fmt.Sprintf("unique-%04d", id)
+			}
+			truth[id] = partialTruthRow{cat, v}
+			if i > start {
+				sql.WriteByte(',')
+			}
+			fmt.Fprintf(&sql, "(%d,'%s','%s')", id, cat, vectorText(v))
+		}
+		mustExec(t, db, sql.String())
+	}
+	mustExec(t, db, fmt.Sprintf("CREATE VECTOR INDEX vi_%s ON %s(e)", table, table))
+	return truth
+}
+
+func checkPartialBudget(t *testing.T, db *DB) {
+	t.Helper()
+	var retained int64
+	for _, table := range db.tables {
+		if table.Index != nil {
+			retained += table.Index.derivedBytes()
+		}
+	}
+	if retained > db.opts.IndexMemBytes {
+		t.Fatalf("aggregate derived bytes %d exceed budget %d", retained, db.opts.IndexMemBytes)
+	}
+}
+
+func checkPartialPrefix(t *testing.T, db *DB, table string) *VecIndex {
+	t.Helper()
+	x := db.tables[table].Index
+	if x == nil || x.Disabled || x.quantRows < quantBlockRows || x.quantRows >= len(x.pks) || x.quantRows%quantBlockRows != 0 {
+		t.Fatalf("expected a nonempty partial encoded prefix in table %s", table)
+	}
+	// No initialized tail storage exists. Any tail qf/code access must fail
+	// instead of accidentally reading zero-filled capacity as valid codes.
+	if len(x.codes) != x.quantRows*x.dim || len(x.qf) != 4*x.quantRows || len(x.qbounds) != x.quantRows/quantBlockRows {
+		t.Fatalf("encoded storage does not end at Q=%d: codes=%d qf=%d bounds=%d", x.quantRows, len(x.codes), len(x.qf), len(x.qbounds))
+	}
+	checkPartialBudget(t, db)
+	return x
+}
+
+func partialUpdate(t *testing.T, db *DB, truth map[int64]partialTruthRow, id int64, cat string, v []float32) {
+	t.Helper()
+	mustExec(t, db, fmt.Sprintf("UPDATE docs SET cat='%s',e='%s' WHERE id=%d", cat, vectorText(v), id))
+	truth[id] = partialTruthRow{cat, append([]float32(nil), v...)}
+}
+
+func partialInsert(t *testing.T, db *DB, table string, truth map[int64]partialTruthRow, id int64, cat string, v []float32) {
+	t.Helper()
+	mustExec(t, db, fmt.Sprintf("INSERT INTO %s VALUES(%d,'%s','%s')", table, id, cat, vectorText(v)))
+	truth[id] = partialTruthRow{cat, append([]float32(nil), v...)}
+}
+
+func clonePartialTruth(src map[int64]partialTruthRow) map[int64]partialTruthRow {
+	dst := make(map[int64]partialTruthRow, len(src))
+	for id, row := range src {
+		dst[id] = partialTruthRow{row.cat, append([]float32(nil), row.vec...)}
+	}
+	return dst
+}
+
+func TestPartialQuantExactMutationAndRecovery(t *testing.T) {
+	hostSIMD := partialQuantTestModes(t)
+	const n, dim, budget = 1539, 33, 180 << 10
+	dir := t.TempDir()
+	db := openPartialDB(t, dir, budget)
+	defer func() { db.Close() }()
+	truth := partialFixture(t, db, "docs", n, dim, false)
+	x := checkPartialPrefix(t, db, "docs")
+	qn := x.quantRows
+	if qn <= n/2 || (n/2)%scanBatch == 0 {
+		t.Fatalf("fixture must split a coded/tail batch in a nonaligned worker: Q=%d split=%d", qn, n/2)
+	}
+	q := make([]float32, dim)
+	batches, coded, uncoded := partialPrefilterBatches.Load(), partialPrefilterRows.Load(), partialUncodedRows.Load()
+	checkPartialTruth(t, db, "docs", truth, q, 17, "", -1)
+	checkPartialTruth(t, db, "docs", truth, q, 17, "c1", -1)
+	checkPartialTruth(t, db, "docs", truth, q, 17, "c1", n/3)
