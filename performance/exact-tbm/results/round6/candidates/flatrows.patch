--- /dev/null
+++ b/minivectordb/internal/engine/select_flatrows_test.go
@@ -0,0 +1,91 @@
+package engine
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"minivectordb/internal/types"
+)
+
+func TestSelectFlatRowsOwnership(t *testing.T) {
+	db := open(t, t.TempDir())
+	defer db.Close()
+	mustExec(t, db, "CREATE TABLE docs(id BIGINT PRIMARY KEY,name VARCHAR(16),e VECTOR(2))")
+	mustExec(t, db, "INSERT INTO docs VALUES(1,'first','[3,4]'),(2,'second','[0,5]'),(3,'third','[6,8]')")
+	sql := "SELECT id,name,e,L2_DISTANCE(e,'[0,0]') AS d FROM docs ORDER BY id"
+	old := mustExec(t, db, sql)
+	want := [][]types.Value{
+		{types.Int(1), types.Str("first"), types.Vec([]float32{3, 4}), types.Float(5)},
+		{types.Int(2), types.Str("second"), types.Vec([]float32{0, 5}), types.Float(5)},
+		{types.Int(3), types.Str("third"), types.Vec([]float32{6, 8}), types.Float(10)},
+	}
+	if !reflect.DeepEqual(old.Rows, want) {
+		t.Fatalf("initial rows=%v want=%v", old.Rows, want)
+	}
+	// An API caller may append to a retained row. It must not overwrite
+	// another row of this result, including a row's vector slice header.
+	grown := append(old.Rows[0], types.Int(99))
+	grown[len(old.Rows[0])] = types.Int(-99)
+	if !reflect.DeepEqual(old.Rows, want) {
+		t.Fatalf("append changed original rows: %v", old.Rows)
+	}
+	// A later result and database mutations must not reuse old result cells
+	// or retain views of mutable request/log data in returned values.
+	next := mustExec(t, db, sql)
+	next.Rows[0][0] = types.Int(100)
+	next.Rows[0][2].V[0] = 100
+	mustExec(t, db, "UPDATE docs SET name='changed',e='[8,15]' WHERE id=1")
+	mustExec(t, db, "DELETE FROM docs WHERE id=2")
+	mustExec(t, db, "INSERT INTO docs VALUES(2,'replaced','[9,12]')")
+	_ = mustExec(t, db, sql)
+	if !reflect.DeepEqual(old.Rows, want) {
+		t.Fatalf("later request changed retained result: %v", old.Rows)
+	}
+}
+
+func TestSelectFlatRowsThreshold(t *testing.T) {
+	db := open(t, t.TempDir())
+	defer db.Close()
+	mustExec(t, db, "CREATE TABLE docs(id BIGINT PRIMARY KEY,n BIGINT)")
+	// Exercise the largest shared two-column result and the first result
+	// above it. Both must preserve all rows and independent append behavior.
+	boundary := maxFlatResultCells / 2
+	var b strings.Builder
+	b.WriteString("INSERT INTO docs VALUES")
+	for id := 1; id <= boundary+1; id++ {
+		if id > 1 {
+			b.WriteByte(',')
+		}
+		fmt.Fprintf(&b, "(%d,%d)", id, -id)
+	}
+	mustExec(t, db, b.String())
+	for _, count := range []int{boundary, boundary + 1} {
+		r := mustExec(t, db, fmt.Sprintf("SELECT id,n FROM docs ORDER BY id LIMIT %d", count))
+		if len(r.Rows) != count {
+			t.Fatalf("rows=%d want=%d", len(r.Rows), count)
+		}
+		grown := append(r.Rows[0], types.Int(999))
+		grown[2] = types.Int(-999)
+		for i, row := range r.Rows {
+			if len(row) != 2 || row[0].K != types.KInt || row[0].I != int64(i+1) || row[1].K != types.KInt || row[1].I != -int64(i+1) {
+				t.Fatalf("count=%d row %d=%v", count, i, row)
+			}
+		}
+	}
+}
+
+func TestFlatResultCellCountOverflow(t *testing.T) {
+	maxInt := int(^uint(0) >> 1)
+	for _, tc := range []struct{ rows, cols, want int }{
+		{0, 2, 0}, {2, 0, 0}, {-1, 2, 0},
+		{10, 2, 20}, {maxFlatResultCells, 1, maxFlatResultCells},
+		{maxFlatResultCells + 1, 1, 0}, {1, maxFlatResultCells + 1, 0},
+		{maxInt, maxInt, 0}, {maxInt, 2, 0}, {2, maxInt, 0},
+	} {
+		if got := flatResultCellCount(tc.rows, tc.cols); got != tc.want {
+			t.Fatalf("rows=%d cols=%d cells=%d want=%d", tc.rows, tc.cols, got, tc.want)
+		}
+	}
+}
