+// Keep shared result storage small: retaining one row can retain at most this
+// many Value bytes, and large results keep their existing per-row allocations.
+// Each result owns its storage; it is never reused by a later request.
+const maxFlatResultBytes = 32 << 10
+const maxFlatResultCells = maxFlatResultBytes / int(unsafe.Sizeof(types.Value{}))
+
+// flatResultCellCount checks by division before multiplying dimensions, so an
+// oversized result cannot overflow into a small shared allocation.
+func flatResultCellCount(rows, cols int) int {
+	if rows <= 0 || cols <= 0 || cols > maxFlatResultCells || rows > maxFlatResultCells/cols {
+		return 0
+	}
+	return rows * cols
 }
 
