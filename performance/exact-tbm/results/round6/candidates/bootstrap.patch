+package engine
+
+import (
+	"math"
+	"os"
+	"sync/atomic"
+)
+
+var bootstrapEnabled = os.Getenv("MVDB_NO_BOOTSTRAP") == ""
+var bootstrapBatches atomic.Int64
+
+const bootstrapMaxK = 16
+
+// bootstrapInput describes one already-validated fused batch. slots is nil
+// for consecutive rows, otherwise it contains exactly rows distinct live slots.
+// All rows satisfy WHERE and no transaction overlay applies.
+type bootstrapInput struct {
+	codes       []byte
+	pks, off    []int64
+	qf          []float64
+	slots       []int32
+	start, rows int
+	bound       quantBlockBound
+}
+
+// bootstrapBatch consumes an empty heap's first batch. It ranks the batch by
+// approximate distance only to choose useful seeds, computes those seeds
+// exactly, and then applies the usual conservative bound to EVERY other row.
+// It returns the number of exact distances computed, or zero when ineligible.
+// Seed selection never excludes a row or supplies a returned distance.
+// Its work/storage is bounded by scanBatch and bootstrapMaxK, never table size.
+func bootstrapBatch(tk *topK, in bootstrapInput, qc []int16, qw []float64, base []byte,
+	qSum, qNorm2 float64, qmin, qscale float32, vecOff int64) int {
+	if !bootstrapEnabled || tk.k < 1 || tk.k > bootstrapMaxK || len(tk.h) != 0 ||
+		in.rows < 2*tk.k || in.rows > scanBatch {
+		return 0
+	}
+	n, dim := in.rows, len(qc)
+	var coffs, rows, pks, soff [scanBatch]int64
+	var dots [scanBatch]int32
+	var approximate, out [scanBatch]float64
+	var seeds [bootstrapMaxK]int
+	var chosen [scanBatch]bool
+	for i := 0; i < n; i++ {
+		s := in.start + i
+		if in.slots != nil {
+			s = int(in.slots[i])
+		}
+		coffs[i] = int64(s) * int64(dim)
+		rows[i], pks[i] = in.off[s], in.pks[s]
+	}
+	dotInt8GatherInt(qc, in.codes, coffs[:n], dots[:n])
+	selected := 0
+	for i := 0; i < n; i++ {
+		s := in.start + i
+		if in.slots != nil {
+			s = int(in.slots[i])
+		}
+		f := in.qf[s*4 : s*4+4]
+		d := foldDist2(qSum, qNorm2, qmin, qscale, dots[i], f[0], f[1], f[2], f[3])
+		// Unknown approximate distances get first chance as seeds and can never
+		// be pruned. This does not change their eventual exact distance.
+		if math.IsNaN(d) {
+			d = math.Inf(-1)
+		}
+		approximate[i] = d
+		at := selected
+		if at == tk.k {
+			at--
+		}
+		if selected == tk.k && !(d < approximate[seeds[at]]) {
+			continue
+		}
+		for at > 0 && d < approximate[seeds[at-1]] {
+			if at < tk.k {
+				seeds[at] = seeds[at-1]
+			}
+			at--
+		}
+		seeds[at] = i
+		if selected < tk.k {
+			selected++
+		}
+	}
+	for j := 0; j < selected; j++ {
+		i := seeds[j]
+		chosen[i] = true
+		soff[j] = rows[i] + vecOff
+	}
+	l2sqGatherBytes(qw, base, soff[:selected], out[:selected])
+	for j := 0; j < selected; j++ {
+		i := seeds[j]
+		if d := out[j]; d <= tk.bound() {
+			tk.admit(d, pks[i], rows[i])
+		}
+	}
+	threshold := in.bound.threshold(qmin, qscale, dim, tk.bound())
+	remaining := 0
+	for i := 0; i < n; i++ {
+		if chosen[i] || approximate[i] > threshold {
+			continue
+		}
+		soff[remaining] = rows[i] + vecOff
+		// Reuse coffs as the fixed-size survivor-to-batch mapping.
+		coffs[remaining] = int64(i)
+		remaining++
+	}
+	l2sqGatherBytes(qw, base, soff[:remaining], out[:remaining])
+	for j := 0; j < remaining; j++ {
+		i := int(coffs[j])
+		if d := out[j]; d <= tk.bound() {
+			tk.admit(d, pks[i], rows[i])
+		}
+	}
+	bootstrapBatches.Add(1)
+	return selected + remaining
+}
