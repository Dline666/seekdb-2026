--- /dev/null
+++ b/minivectordb/internal/engine/bootstrap_test.go
@@ -0,0 +1,239 @@
+package engine
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+	"math/rand"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// Independent float64 brute-force ranking. No quantization, engine distance,
+// heap comparator, or production prefilter participates in this oracle.
+func bootstrapReference(vectors [][]float32, pks []int64, slots []int32, q []float32, k int) []hit {
+	var all []hit
+	visit := func(s int) {
+		d := 0.0
+		for j, f := range vectors[s] {
+			delta := float64(f) - float64(q[j])
+			d += delta * delta
+		}
+		all = append(all, hit{d: d, pk: pks[s], off: int64(s)})
+	}
+	if slots == nil {
+		for s := range vectors {
+			visit(s)
+		}
+	} else {
+		for _, s := range slots {
+			visit(int(s))
+		}
+	}
+	sort.Slice(all, func(i, j int) bool {
+		if all[i].d != all[j].d {
+			return all[i].d < all[j].d
+		}
+		return all[i].pk < all[j].pk
+	})
+	if len(all) > k {
+		all = all[:k]
+	}
+	return all
+}
+
+func TestBootstrapFirstBatchIndependentTruth(t *testing.T) {
+	old := bootstrapEnabled
+	bootstrapEnabled = true
+	defer func() { bootstrapEnabled = old }()
+	const n, dim = 128, 33
+	rng := rand.New(rand.NewSource(92981))
+	vectors := make([][]float32, n)
+	in := bootstrapInput{codes: make([]byte, n*dim), pks: make([]int64, n), off: make([]int64, n), qf: make([]float64, n*4), rows: n}
+	base := make([]byte, n*dim*4)
+	for i := 0; i < n; i++ {
+		v := make([]float32, dim)
+		for j := range v {
+			v[j] = float32(rng.Intn(9)-4) / 4
+		}
+		if i == 0 || i == 63 || i == 127 {
+			clear(v)
+		}
+		vectors[i] = v
+		in.pks[i] = int64(n - i)
+		in.off[i] = int64(i * dim * 4)
+		for j, f := range v {
+			binary.LittleEndian.PutUint32(base[(i*dim+j)*4:], math.Float32bits(f))
+		}
+		qp := quantizeRow(v, in.codes[i*dim:(i+1)*dim])
+		in.qf[4*i], in.qf[4*i+1], in.qf[4*i+2], in.qf[4*i+3] = foldQparam(qp, dim)
+		in.bound.add(qp.scale, math.Abs(float64(qp.min))+256*float64(qp.scale))
+	}
+	q := make([]float32, dim)
+	mn, sc, qc, sum, norm, _ := quantizeQuery(q)
+	for _, shuffled := range []bool{false, true} {
+		input := in
+		if shuffled {
+			input.slots = make([]int32, n)
+			for i, s := range rng.Perm(n) {
+				input.slots[i] = int32(s)
+			}
+		}
+		for _, nonfinite := range []bool{false, true} {
+			input.qf = append([]float64(nil), in.qf...)
+			if nonfinite {
+				// Unknown and deliberately optimistic approximations must not become
+				// answers, omit unseeded rows, or duplicate one row in the final heap.
+				input.qf[3] = math.NaN()
+				input.qf[4*1+3] = -1e30
+			}
+			for _, k := range []int{1, 10, 16} {
+				tk := &topK{k: k}
+				count := bootstrapBatch(tk, input, qc, widen(q), base, sum, norm, mn, sc, 0)
+				if count < k || count > n {
+					t.Fatalf("exact count=%d k=%d", count, k)
+				}
+				want := bootstrapReference(vectors, in.pks, input.slots, q, k)
+				offs, dists := tk.result()
+				if len(offs) != len(want) {
+					t.Fatalf("result count=%d want=%d", len(offs), len(want))
+				}
+				seen := map[int64]bool{}
+				for i, w := range want {
+					if seen[offs[i]] {
+						t.Fatal("seed admitted more than once")
+					}
+					seen[offs[i]] = true
+					if offs[i] != w.off*dim*4 || dists[i] != w.d {
+						t.Fatalf("shuffle=%v exceptional=%v k=%d rank=%d got=(%d,%g) want=(%d,%g)", shuffled, nonfinite, k, i, offs[i], dists[i], w.off*dim*4, w.d)
+					}
+				}
+			}
+		}
+	}
+	// All ineligible helper calls leave the heap untouched.
+	for _, tc := range []struct{ k, n int }{{0, 128}, {17, 128}, {10, 19}, {10, 129}} {
+		input := in
+		input.rows = tc.n
+		tk := &topK{k: tc.k}
+		if bootstrapBatch(tk, input, qc, widen(q), base, sum, norm, mn, sc, 0) != 0 || len(tk.h) != 0 {
+			t.Fatalf("ineligible bootstrap changed heap k=%d n=%d", tc.k, tc.n)
+		}
+	}
+	tk := &topK{k: 10}
+	tk.admit(0, 1, 0)
+	if bootstrapBatch(tk, in, qc, widen(q), base, sum, norm, mn, sc, 0) != 0 || len(tk.h) != 1 {
+		t.Fatal("nonempty heap bootstrapped")
+	}
+}
+
+func TestBootstrapFirstAndLaterBatchesExact(t *testing.T) {
+	if !useSIMD {
+		t.Skip("production bootstrap requires SIMD")
+	}
+	oldBoot, oldPF, oldSix, oldParallel := bootstrapEnabled, prefilterEnabled, prefilter6Bit, parallelMinSlots
+	defer func() {
+		bootstrapEnabled, prefilterEnabled, prefilter6Bit, parallelMinSlots = oldBoot, oldPF, oldSix, oldParallel
+	}()
+	bootstrapEnabled, prefilterEnabled, prefilter6Bit = true, true, false
+	const n = 333
+	for _, kind := range []string{"coarse", "large_constant", "overflow_scale"} {
+		dim := 33
+		if kind == "large_constant" {
+			dim = 128
+		}
+		db := open(t, t.TempDir())
+		vectors := make([][]float32, n)
+		pks := make([]int64, n)
+		q := make([]float32, dim)
+		if kind == "large_constant" {
+			for j := range q {
+				q[j] = 7722174976
+			}
+		}
+		var sql strings.Builder
+		mustExec(t, db, fmt.Sprintf("CREATE TABLE docs(id BIGINT PRIMARY KEY,cat VARCHAR(8),e VECTOR(%d))", dim))
+		sql.WriteString("INSERT INTO docs VALUES")
+		for i := 0; i < n; i++ {
+			v := make([]float32, dim)
+			for j := range v {
+				switch kind {
+				case "coarse":
+					v[j] = float32((i*17+j*7)%13+1) / 8
+				case "large_constant":
+					v[j] = q[j]
+				case "overflow_scale":
+					v[j] = math.MaxFloat32
+					if j%2 == 1 {
+						v[j] = -math.MaxFloat32
+					}
+				}
+			}
+			if kind == "coarse" && (i == 0 || i == 127 || i == 128 || i == n-1) {
+				clear(v)
+			}
+			vectors[i], pks[i] = v, int64(n-i)
+			if i > 0 {
+				sql.WriteByte(',')
+			}
+			fmt.Fprintf(&sql, "(%d,'c%d','%s')", pks[i], pks[i]%2, vectorText(v))
+		}
+		mustExec(t, db, sql.String())
+		check := func(filter, k int) {
+			t.Helper()
+			var slots []int32
+			where := ""
+			if filter >= 0 {
+				where = fmt.Sprintf(" WHERE cat='c%d'", filter)
+				for i, pk := range pks {
+					if pk%2 == int64(filter) {
+						slots = append(slots, int32(i))
+					}
+				}
+			}
+			want := bootstrapReference(vectors, pks, slots, q, k)
+			got := mustExec(t, db, fmt.Sprintf("SELECT id,L2_DISTANCE(e,'%s') AS d FROM docs%s ORDER BY d LIMIT %d", vectorText(q), where, k)).Rows
+			if len(got) != len(want) {
+				t.Fatalf("%s filter=%d count=%d want=%d", kind, filter, len(got), len(want))
+			}
+			for i, w := range want {
+				distance := math.Sqrt(w.d)
+				if got[i][0].I != w.pk || math.Abs(got[i][1].F-distance) > 1e-12*math.Max(1, distance) {
+					t.Fatalf("%s filter=%d k=%d rank=%d got=(%d,%g) want=(%d,%g)", kind, filter, k, i, got[i][0].I, got[i][1].F, w.pk, distance)
+				}
+			}
+		}
+		for _, parallel := range []int{math.MaxInt, 1} {
+			parallelMinSlots = parallel
+			before := bootstrapBatches.Load()
+			for _, filter := range []int{-1, 0, 1} {
+				for _, k := range []int{1, 10, 16, 17} {
+					check(filter, k)
+				}
+			}
+			if bootstrapBatches.Load() == before {
+				t.Fatalf("%s: bootstrap path never ran", kind)
+			}
+		}
+		// Predicates beyond a covering equality and transaction overlays must
+		// retain their original scan path, including an update inside BEGIN.
+		parallelMinSlots = math.MaxInt
+		before := bootstrapBatches.Load()
+		mustExec(t, db, fmt.Sprintf("SELECT id FROM docs WHERE id>0 ORDER BY L2_DISTANCE(e,'%s') LIMIT 10", vectorText(q)))
+		if bootstrapBatches.Load() != before {
+			t.Fatal("residual predicate used bootstrap")
+		}
+		mustExec(t, db, "BEGIN")
+		mustExec(t, db, "UPDATE docs SET cat='c2' WHERE id=1")
+		before = bootstrapBatches.Load()
+		mustExec(t, db, fmt.Sprintf("SELECT id FROM docs ORDER BY L2_DISTANCE(e,'%s') LIMIT 10", vectorText(q)))
+		if bootstrapBatches.Load() != before {
+			t.Fatal("overlay used bootstrap")
+		}
+		mustExec(t, db, "ROLLBACK")
+		if err := db.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
