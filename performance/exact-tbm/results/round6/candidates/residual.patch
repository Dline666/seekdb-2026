+package engine
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"math/rand"
+	"testing"
+	"unsafe"
+)
+
+// Independent exact rational oracle over the original float32 vector and
+// final integer codes. It does not use any distance or error-bound helper.
+func residualSquaredOracle(v []float32, mn, scale float32, code func(int) int64) *big.Rat {
+	sum := new(big.Rat)
+	minR := new(big.Rat).SetFloat64(float64(mn))
+	scaleR := new(big.Rat).SetFloat64(float64(scale))
+	for i, f := range v {
+		reconstruction := new(big.Rat).Mul(scaleR, new(big.Rat).SetInt64(code(i)))
+		reconstruction.Add(reconstruction, minR)
+		delta := new(big.Rat).Sub(new(big.Rat).SetFloat64(float64(f)), reconstruction)
+		sum.Add(sum, new(big.Rat).Mul(delta, delta))
+	}
+	return sum
+}
+
+func checkResidualOracle(t *testing.T, tag string, got float64, exactSq *big.Rat) {
+	t.Helper()
+	if math.IsInf(got, 1) {
+		return
+	}
+	if !(got >= 0) {
+		t.Fatalf("%s: invalid bound %g", tag, got)
+	}
+	square := new(big.Rat).SetFloat64(got)
+	square.Mul(square, square)
+	if square.Cmp(exactSq) < 0 {
+		exact, _ := exactSq.Float64()
+		t.Fatalf("%s: bound^2=%g is below exact residual squared=%g", tag, got*got, exact)
+	}
+}
+
+func TestResidualNormRationalOracle(t *testing.T) {
+	rng := rand.New(rand.NewSource(66117))
+	vectors := [][]float32{
+		{0, 0, 0, 0},
+		{math.SmallestNonzeroFloat32, 0, -math.SmallestNonzeroFloat32, 2 * math.SmallestNonzeroFloat32},
+		{1, math.Nextafter32(1, 2), math.Nextafter32(1, 0), 1},
+		{math.MaxFloat32, math.MaxFloat32, math.MaxFloat32},
+		{-math.MaxFloat32, 0, math.MaxFloat32}, // float32 range overflow
+		{0, math.Float32frombits(0x00ffffff), math.Float32frombits(0x00800000)},
+	}
+	for _, dim := range []int{16, 31, 128, 257, 1024} {
+		for trial := 0; trial < 12; trial++ {
+			v := make([]float32, dim)
+			for i := range v {
+				switch trial % 4 {
+				case 0:
+					v[i] = rng.Float32()
+				case 1:
+					v[i] = float32(math.Ldexp(rng.NormFloat64(), rng.Intn(240)-120))
+				case 2:
+					v[i] = math.Float32frombits(uint32(rng.Intn(1 << 24)))
+				case 3:
+					v[i] = 7722174976
+					if i%3 == 0 {
+						v[i] = math.Nextafter32(v[i], float32(math.Inf(1)))
+					}
+				}
+			}
+			vectors = append(vectors, v)
+		}
+	}
+	// The highest supported dimension also exercises norm summation inflation.
+	maxdim := make([]float32, maxInt8Dim)
+	for i := range maxdim {
+		maxdim[i] = rng.Float32()
+	}
+	vectors = append(vectors, maxdim)
+	for at, v := range vectors {
+		codes := make([]byte, len(v))
+		qp := quantizeRow(v, codes)
+		if math.IsInf(float64(qp.scale), 0) {
+			if !math.IsInf(qp.residual, 1) {
+				t.Fatal("overflowed row scale must disable pruning")
+			}
+		} else {
+			checkResidualOracle(t, fmt.Sprintf("row-%d", at), qp.residual,
+				residualSquaredOracle(v, qp.min, qp.scale, func(i int) int64 { return int64(codes[i]) }))
+		}
+		mn, scale, qc, _, _, residual, ok := quantizeQueryResidual(v)
+		if !ok {
+			if !math.IsInf(float64(qp.scale), 0) {
+				t.Fatalf("finite-scale query %d rejected", at)
+			}
+		} else {
+			checkResidualOracle(t, fmt.Sprintf("query8-%d", at), residual,
+				residualSquaredOracle(v, mn, scale, func(i int) int64 { return int64(qc[i]) }))
+		}
+		mn, scale, qc6, _, _, residual, ok := quantizeQuery6Residual(v)
+		if ok {
+			checkResidualOracle(t, fmt.Sprintf("query6-%d", at), residual,
+				residualSquaredOracle(v, mn, scale, func(i int) int64 { return int64(qc6[i]) }))
+		} else if !math.IsInf(float64(qp.scale), 0) {
+			t.Fatalf("finite-scale six-bit query %d rejected", at)
+		}
+	}
+}
+
+func TestResidualThresholdIndependentDistance(t *testing.T) {
+	rng := rand.New(rand.NewSource(77012))
+	for _, dim := range []int{16, 31, 128, 257, 1024} {
+		for trial := 0; trial < 80; trial++ {
+			v, q := make([]float32, dim), make([]float32, dim)
+			for i := range v {
+				switch trial % 5 {
+				case 0:
+					v[i], q[i] = rng.Float32(), rng.Float32()
+				case 1:
+					v[i] = float32(rng.NormFloat64() * 1e-30)
+					q[i] = float32(rng.NormFloat64() * 1e-30)
+				case 2:
+					v[i] = float32(math.Ldexp(rng.NormFloat64(), rng.Intn(240)-120))
+					q[i] = v[i]
+				case 3:
+					v[i] = 7722174976
+					q[i] = math.Nextafter32(v[i], float32(math.Inf(1)))
+				case 4:
+					v[i] = float32(rng.NormFloat64() * 1e30)
+					q[i] = float32(rng.NormFloat64() * 1e30)
+				}
+			}
+			codes := make([]byte, dim)
+			qp := quantizeRow(v, codes)
+			for _, six := range []bool{false, true} {
+				var mn, scale float32
+				var sum, norm, residual float64
+				var dot int32
+				if six {
+					var qc []int8
+					var ok bool
+					mn, scale, qc, sum, norm, residual, ok = quantizeQuery6Residual(q)
+					if !ok {
+						t.Fatal("query unexpectedly rejected")
+					}
+					for i, c := range codes {
+						dot += int32(c) * int32(qc[i])
+					}
+				} else {
+					var qc []int16
+					var ok bool
+					mn, scale, qc, sum, norm, residual, ok = quantizeQueryResidual(q)
+					if !ok {
+						t.Fatal("query unexpectedly rejected")
+					}
+					for i, c := range codes {
+						dot += int32(c) * int32(qc[i])
+					}
+				}
+				// Independent, unfused, sequential sum over input vectors. Also check a
+				// few ulps below it to cover different exact-kernel reduction rounding.
+				exact := 0.0
+				for i, f := range v {
+					d := float64(f) - float64(q[i])
+					exact += d * d
+				}
+				for i := 0; i < 8 && exact > 0; i++ {
+					exact = math.Nextafter(exact, 0)
+				}
+				m2, t2, s2, cr := foldQparam(qp, dim)
+				approx := foldDist2(sum, norm, mn, scale, dot, m2, t2, s2, cr)
+				b := quantBlockBound{maxAbs: math.Abs(float64(qp.min)) + 256*float64(qp.scale), maxResidual: qp.residual}
+				threshold := b.threshold(mn, scale, dim, exact, residual)
+				if approx > threshold {
+					t.Fatalf("unsafe prune dim=%d trial=%d six=%v approximate=%g threshold=%g", dim, trial, six, approx, threshold)
+				}
+			}
+		}
+	}
+	for _, bad := range []float64{math.NaN(), math.Inf(1), -1} {
+		if !math.IsInf(residualThreshold(bad, 0, 1), 1) || !math.IsInf(residualThreshold(0, bad, 1), 1) {
+			t.Fatal("invalid residual did not disable pruning")
+		}
+	}
+}
+
+func TestResidualBoundsRemainBlockLocalAndTighter(t *testing.T) {
+	if unsafe.Sizeof(quantBlockBound{}) != 16 {
+		t.Fatal("block bound memory budget changed")
+	}
+	rng := rand.New(rand.NewSource(8192))
+	const dim = 128
+	b := quantBlockBound{}
+	var oldScale float32
+	for row := 0; row < quantBlockRows; row++ {
+		v := make([]float32, dim)
+		for i := range v {
+			v[i] = rng.Float32()
+		}
+		qp := quantizeRow(v, make([]byte, dim))
+		b.add(qp.residual, math.Abs(float64(qp.min))+256*float64(qp.scale))
+		oldScale = max(oldScale, qp.scale)
+	}
+	q := make([]float32, dim)
+	for i := range q {
+		q[i] = rng.Float32()
+	}
+	mn, scale, _, _, _, residual, ok := quantizeQueryResidual(q)
+	if !ok {
+		t.Fatal("finite query rejected")
+	}
+	old := prefilterThreshold(oldScale+scale, dim, 12) + prefilterRoundSlack(b.maxAbs, mn, scale, dim)
+	tight := b.threshold(mn, scale, dim, 12, residual)
+	if !(tight < old) {
+		t.Fatalf("actual residual did not tighten threshold: %g >= %g", tight, old)
+	}
+	// Monotone update and arbitrary candidate batches must never lose the
+	// maximum of a covered block, including a non-finite residual.
+	x := &VecIndex{qbounds: []quantBlockBound{b, {maxAbs: 1e30, maxResidual: 1e20}, b}}
+	if got := x.boundForSlots([]int32{0, 300}); got.maxResidual != b.maxResidual {
+		t.Fatal("unvisited outlier block leaked")
+	}
+	if got := x.boundForSlots([]int32{300, 128, 0}); got.maxResidual != 1e20 {
+		t.Fatal("candidate merge lost outlier")
+	}
+	b.add(math.Inf(1), 1)
+	if !math.IsInf(b.threshold(mn, scale, dim, 12, residual), 1) {
+		t.Fatal("non-finite row residual narrowed threshold")
+	}
+}
