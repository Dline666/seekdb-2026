+	VCVTPS2PD (DI), Y0
+	VSUBPD Y6, Y0, Y0
+	VDIVPD Y7, Y0, Y0
+	VCVTTPD2DQY Y0, X1
+	VCVTDQ2PD X1, Y2
+	VSUBPD Y2, Y0, Y0
+	VCMPPD $29, Y4, Y0, Y0
+	VANDPD Y3, Y0, Y0
+	VCVTTPD2DQY Y0, X2
+	VPADDD X2, X1, X1
+	VPMAXSD X10, X1, X1
+	VPMINSD X5, X1, X1
+	VPADDD X1, X8, X8
+	VPMULLD X1, X1, X2
+	VPADDD X2, X9, X9
+	VPACKUSDW X1, X1, X1
+	VPACKUSWB X1, X1, X1
